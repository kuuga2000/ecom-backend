{
  "name": "Ecommerce backend (Java 25)",
  "image": "maven:3.9.11-eclipse-temurin-25",
  "workspaceFolder": "/workspaces/ecom-backend",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": [
    "/bin/bash",
    "-o",
    "pipefail",
    "-c",
    "curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 CODEX_INSTALL_DIR=/usr/local/bin sh"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "openai.chatgpt"
      ]
    }
  }
}
